{
  "name": "opencode-mem",
  "version": "2.42.0",
  "description": "OpenCode plugin that gives coding agents persistent memory using local Turso/libSQL vector search",
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "exports": {
    ".": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    },
    "./server": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    },
    "./v2": {
      "import": "./dist/v2/plugin.js",
      "types": "./dist/v2/plugin.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    },
    "./tags": {
      "import": "./dist/services/tags.js",
      "types": "./dist/services/tags.d.ts"
    }
  },
  "scripts": {
    "build": "bun scripts/build-plugin.mjs && bun run web:build",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun run build",
    "dev": "bun --watch scripts/build-plugin.mjs",
    "test": "bun test",
    "typecheck": "bun check",
    "lint": "oxlint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "bun run format:check && bun run lint && bun run typecheck",
    "prepare": "husky"
  },
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "vector-database",
    "ai",
    "coding-agent",
    "local",
    "standalone"
  ],
  "author": "opencode-mem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tickernelz/opencode-mem.git"
  },
  "homepage": "https://opencode-mem.zhafron.my.id",
  "bugs": {
    "url": "https://github.com/tickernelz/opencode-mem/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@opencode-ai/plugin": "^1.19.0",
    "@opencode-ai/sdk": "^1.19.0",
    "@opencode/plugin": "^2.0.27",
    "franc-min": "^6.2.0",
    "iso-639-3": "^3.0.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "bun-types": "1.3.14"
  },
  "devDependencies": {
    "@interfere/landmines": "^0.0.0",
    "@types/bun": "^1.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "chat.message",
      "chat.params",
      "event"
    ]
  },
  "files": [
    "dist",
    "package.json"
  ],
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.svelte": [
      "prettier --write"
    ],
    "*.astro": [
      "prettier --write"
    ],
    "*.{css,html,json,jsonc,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
